# Rallly 환경 변수 샘플 (.env 로 복사해서 값을 채우세요)

# 세션 암호화 키. 반드시 32자 이상 (`openssl rand -hex 16` 로 생성)
SECRET_PASSWORD=CHANGE_ME_32_CHARS_MINIMUM_SECRET

# PostgreSQL 사용자(rallly) 비밀번호. DATABASE_URL 에 그대로 들어가므로 특수문자는 피하세요
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# 메일 발송용 SMTP 비밀번호 (또는 API 키)
SMTP_PWD=CHANGE_ME_SMTP_PASSWORD
