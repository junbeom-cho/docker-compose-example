# 세션/쿠키 암호화 키. `openssl rand -hex 32` 로 생성한 64자 hex 값
SECRET_KEY=CHANGE_ME_64_HEX_CHARS

# 내부 유틸리티 엔드포인트 인증 키. `openssl rand -hex 32` 로 생성한 64자 hex 값
UTILS_SECRET=CHANGE_ME_64_HEX_CHARS

# PostgreSQL 사용자(outline) 비밀번호
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# 메일 발송용 SMTP 비밀번호 (또는 API 키)
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
