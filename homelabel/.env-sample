# 이 파일을 .env 로 복사한 뒤 값을 채운다.

# JWT 서명 키. 기본값이 없어서 안 넣으면 backend 가 기동하지 못한다
# 생성: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_SECRET_KEY

# admin 계정 비밀번호의 bcrypt 해시. 해시에 $ 가 들어가므로 반드시 작은따옴표로 감싼다
# 생성: python3 -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
AUTH_PASSWORD_HASH='CHANGE_ME_BCRYPT_HASH'

# AI 클라이언트가 MCP 서버에 붙을 때 쓰는 키
MCP_API_KEY=CHANGE_ME_MCP_API_KEY

# MCP 서버가 backend 에 붙을 때 쓰는 내부 키 (외부에 노출하지 않는다)
MCP_SERVICE_KEY=CHANGE_ME_MCP_SERVICE_KEY
