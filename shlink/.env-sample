# Shlink API 키 (백엔드가 최초 기동 시 이 키를 생성하고, 웹 UI 도 같은 키로 접속한다)
SHLINK_API_KEY=CHANGE_ME_SHLINK_API_KEY

# MaxMind GeoLite2 라이선스 키 (https://www.maxmind.com 에서 무료 발급)
# 잘못된 값을 넣으면 백엔드가 DB 다운로드에 실패해 기동이 깨지므로, 쓰지 않을 거면 반드시 빈 값으로 둔다
GEOLITE_LICENSE_KEY=

# PostgreSQL 비밀번호
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
